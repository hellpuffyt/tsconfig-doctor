{
  "name": "tsconfig-doctor",
  "version": "0.1.0",
  "description": "Diagnose the tsconfig.json settings that silently change what your code does, and explain the consequence of each rather than the setting.",
  "keywords": [
    "tsconfig",
    "typescript",
    "compiler-options",
    "lint",
    "config",
    "extends",
    "strict"
  ],
  "license": "MIT",
  "author": "Prabesh Sharma",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellpuffyt/tsconfig-doctor.git"
  },
  "homepage": "https://github.com/hellpuffyt/tsconfig-doctor#readme",
  "bugs": {
    "url": "https://github.com/hellpuffyt/tsconfig-doctor/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "tsconfig-doctor": "dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.6",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^4.1.12"
  }
}
