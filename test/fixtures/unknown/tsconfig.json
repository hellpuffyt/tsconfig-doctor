{
  "compilerOptions": {
    "strict": true,
    "strictNullCheck": true,
    "target": "es2022",
    "noUnusedVariables": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  },
  "include": ["src"]
}
